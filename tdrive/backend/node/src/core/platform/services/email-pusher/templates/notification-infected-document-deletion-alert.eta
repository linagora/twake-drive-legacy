<% layout('./_structure') %>
<% it.title = 'Twake Drive Infected Document Deletion Alert' %>

<%~ includeFile("./common/_body.eta", {
  paragraphs: [
  `
  <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="vertical-align:top;" width="100%" >
      <tbody>
          <tr>
              <td align="center" style="font-size:0px;padding:0 0 8px;word-break:break-word;">
                  <div style="font-family:Ubuntu, Helvetica, Arial, sans-serif;font-size:24px;font-weight:800;line-height:29px;text-align:center;color:#FF0000;">
                    ${it.t("email.infected-document-deletion.heading")}
                  </div>
              </td>
          </tr>
      </tbody>
  </table>
  `,
  `
  <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="vertical-align:top;" width="100%" >
      <tbody>
          <tr>
              <td align="center" style="font-size:0px;padding:0 0 16px;word-break:break-word;" >
                  <div style="font-family:Ubuntu, Helvetica, Arial, sans-serif;font-size:16px;line-height:29px;text-align:center;color:#000000;">
                    <span style="font-weight: 500">${it.t("email.infected-document-deletion.body")}</span>
                  </div>
                  <div style="font-family:Ubuntu, Helvetica, Arial, sans-serif;font-size:16px;line-height:29px;text-align:center;color:#000000;">
                    <span style="font-weight: 500">
                      ${it.t("email.infected-document-deletion.file-label")}: ${it.notifications[0].item.name}
                    </span>
                  </div>
                  <div style="font-family:Ubuntu, Helvetica, Arial, sans-serif;font-size:16px;line-height:29px;text-align:center;color:#000000;">
                    <span style="color: #FF0000; font-weight: 600;">
                      ${it.t("email.infected-document-deletion.issue-label")}: ${ it.notifications[0].item.av_status === "scan_failed" ? it.t("email.infected-document-deletion.scan-failed") + " 🔍" : it.notifications[0].item.av_status === "malicious" ? it.t("email.infected-document-deletion.malicious") + " ⚠️" : it.t("email.infected-document-deletion.too-large") + " 🚫" }
                    </span>
                  </div>
              </td>
          </tr>
      </tbody>
  </table>
  `
  ]
}) %>
